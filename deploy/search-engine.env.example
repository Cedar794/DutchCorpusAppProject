DATABASE_URL=postgresql://search_service_user:CHANGE_ME@127.0.0.1:5433/dutch_lexicon
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEARCH_SEMANTIC_ENABLED=false
SEARCH_EMBEDDING_MODEL=text-embedding-v4
SEARCH_EMBEDDING_DIM=1024
SEARCH_INDEX_VERSION=search-v1
SEARCH_MAX_LIMIT=50
SEARCH_LOG_QUERIES=false
SEARCH_USE_DEMO_EMBEDDINGS=false
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8080
SEARCH_TRUSTED_PROXIES=127.0.0.1
SEARCH_RATE_LIMIT_PER_MINUTE=60
SEARCH_SEMANTIC_RATE_LIMIT_PER_MINUTE=10
# At most this many queries in any sliding 10-second interval.
SEARCH_RATE_LIMIT_BURST=10

# All semantic requests attempt one rewrite; there is no separate intent model.
SEARCH_REWRITE_ENABLED=true
BAILIAN_REWRITE_API_KEY=
BAILIAN_REWRITE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEARCH_REWRITE_TIMEOUT_MS=1200
# Separate online budget. Zero blocks online model calls; set only with an approved budget.
# Includes Flash rewrite AND v4 query embeddings, not offline index generation.
SEARCH_API_BUDGET_TOTAL_CNY=0
SEARCH_API_BUDGET_DAILY_CNY=0
SEARCH_API_BUDGET_LEDGER=/var/lib/dutch-search/api-budget.sqlite3
